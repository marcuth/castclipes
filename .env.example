# ===== Fontes (RSS) =====
# IDs das playlists de LIVES (UULV...) dos canais de podcast monitorados, separados por vírgula.
# O projeto só processa lives encerradas. Descubra com: python -m castclipes resolve-channel @canal
# ou pelo site: https://newskeeper.pages.dev/tools/youtube-rss
SOURCE_LIVE_PLAYLIST_IDS=
POLL_INTERVAL_SECONDS=900
SOURCE_MAX_AGE_HOURS=48
# Se o RSS do YouTube falhar (404 é comum), lê as N lives mais recentes via yt-dlp. 0 = sem reserva
SOURCE_FALLBACK_LIMIT=5
# Vídeos-fonte fora dessa faixa são ignorados
SOURCE_MIN_DURATION_SECONDS=600
SOURCE_MAX_DURATION_SECONDS=36000
# Lives no ar/agendadas aguardam; só lives encerradas são processadas (regra fixa)
# Live encerrada sem legenda: espera isso antes de recorrer ao Whisper
LIVE_CAPTION_WAIT_MINUTES=90

# ===== Relevância =====
# Vídeo sem legenda só é baixado/transcrito se a IA der nota >= isso (0-1)
TRIAGE_MIN_SCORE=0.7

# ===== Formatos =====
# long = corte horizontal 16:9 (um assunto, minutos). short = vertical 9:16 (um gancho, segundos,
# com rosto enquadrado, split-screen e legenda palavra a palavra). Separe por vírgula para os dois.
CLIP_FORMATS=long,short
# Folga antes/depois do corte longo, ajustada às fronteiras de frase
CLIP_EDGE_PADDING_SECONDS=0.5
# Quem escolhe os cortes: ai = a IA; heuristics = pontuação por regras, sem IA nesta etapa
# (triagem e metadados continuam usando a IA). Veja docs/clip-selection.md
SELECTOR_ENGINE=ai
# Só no modo heuristics: ignora os primeiros N segundos da live (abertura, avisos, espera)
HEURISTIC_SKIP_INTRO_SECONDS=120
# SÃ³ no modo heuristics: ignora os Ãºltimos N segundos da live (despedida, crÃ©ditos); 0 desliga
HEURISTIC_SKIP_OUTRO_SECONDS=0
# Lives longas são analisadas em janelas para caber no contexto da IA
SELECTION_WINDOW_SECONDS=3600
SELECTION_WINDOW_OVERLAP_SECONDS=300

# ===== Cortes longos =====
LONG_MIN_SECONDS=600
LONG_MAX_SECONDS=2400
LONG_TARGET_SECONDS=1320
LONG_MIN_SCORE=0.6
MAX_LONG_PER_VIDEO=3

# ===== Shorts =====
SHORT_MIN_SECONDS=20
SHORT_MAX_SECONDS=85
SHORT_TARGET_SECONDS=45
SHORT_MIN_SCORE=0.7
MAX_SHORTS_PER_VIDEO=8
SHORT_EDGE_PADDING_SECONDS=0.2

# ===== Corte de silêncio (só no corte longo) =====
SILENCE_CUT_ENABLED=true
SILENCE_THRESHOLD_DB=-35
# Só pausas maiores que isso são encurtadas
SILENCE_MIN_DURATION_SECONDS=0.8
# Quanto de cada pausa é mantido em cada ponta
SILENCE_KEEP_PADDING_SECONDS=0.25

# ===== Molduras e overlays (opcionais; deixe vazio para desligar) =====
# Moldura PNG com transparência, esticada sobre o vídeo inteiro. Uma por formato:
# 1920x1080 para o corte longo e 1080x1920 para o short (a proporção errada distorce).
LONG_FRAME_PATH=
SHORT_FRAME_PATH=
# Só no corte longo: vídeo de CTA/anúncio inserido no meio (sem overlays), numa pausa entre frases
CTA_VIDEO_PATH=
# Ponto do corte (0 a 1) onde ele entra; vai para a melhor fronteira de frase perto desse ponto
CTA_POSITION_PCT=0.5
# Cortes longos mais curtos que isso (s) não recebem CTA
CTA_MIN_CLIP_SECONDS=480
# Só no corte longo: vídeo anexado ao fim
OUTRO_PATH=

# ===== Shorts: enquadramento e legendas =====
SHORT_WIDTH=1080
SHORT_HEIGHT=1920
# Quadros/s analisados para achar rostos (mais = mais preciso e mais lento)
SHORT_FRAMING_SAMPLE_FPS=5
# Divide a tela em dois blocos quando há dois interlocutores; chance de usar quando há dois rostos
SHORT_SPLIT_SCREEN=true
SHORT_SPLIT_CHANCE=0.5
# Legenda animada palavra a palavra (Remotion, fonte Poppins; exige Node/npm — a 1ª vez roda `npm install` em remotion/)
SHORT_CAPTIONS=true
# Re-transcreve cada short com Whisper para o tempo exato das palavras (precisa de .[whisper]);
# false ou sem o extra = tempo estimado a partir da legenda do vídeo
SHORT_CAPTIONS_WHISPER=true
# Cor da palavra que está sendo falada
SHORT_CAPTION_HIGHLIGHT=#FFD400
# Distância da legenda até a base do vídeo (px, em 1920 de altura)
SHORT_CAPTION_MARGIN_V=520

# ===== Render =====
# ffmpeg = rápido (padrão). moviepy = reserva, bem mais lento
RENDER_ENGINE=ffmpeg
RENDER_FPS=30
RENDER_PRESET=medium
RENDER_CRF=21
RENDER_THREADS=4
# Altura máxima do vídeo baixado
MAX_SOURCE_HEIGHT=1080

# ===== IA (AI SDK para Python, pacote `ai`) =====
# ID de provedor do models.dev: openai, anthropic, groq, openrouter...
# (anthropic exige: pip install "ai[anthropic]")
AI_PROVIDER=openai
# Vazio = padrão do provedor. Ex. Ollama: http://localhost:11434/v1
AI_BASE_URL=
# Vazio = o SDK lê a variável do provedor (ex.: OPENAI_API_KEY)
AI_API_KEY=
# auto | chat_completions | responses. auto = chat completions se AI_BASE_URL estiver definido
AI_PROTOCOL=auto
AI_MODEL=gpt-4.1-mini
AI_TEMPERATURE=0.3
# Opcional. Tentativas extras se a chamada falhar (429, 5xx, resposta vazia). 0 = desligado.
# A espera começa em AI_RETRY_DELAY_SECONDS, dobra a cada falha e para em AI_RETRY_MAX_DELAY_SECONDS
AI_MAX_RETRIES=0
AI_RETRY_DELAY_SECONDS=5
AI_RETRY_MAX_DELAY_SECONDS=60

# ===== Transcrição =====
TRANSCRIPT_LANGUAGES=pt,pt-BR
# Whisper local (pip install -e .[whisper]): vídeo sem legenda e tempo das palavras dos shorts
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8

# ===== Metadados de publicação =====
TITLE_MAX_CHARS=100
# natural = frase como a IA escreveu. upper = CAIXA ALTA com preposições em minúsculo
TITLE_STYLE=natural
FIXED_TAGS=podcast,cortes de podcast
FIXED_HASHTAGS=podcast,cortes
# Nome do SEU canal de cortes
CHANNEL_NAME=
DESCRIPTION_HEADER=
DESCRIPTION_FOOTER=
WATCH_MORE_LABEL=Quer ver o episódio completo?
WATCH_MORE_URL=
# Linhas livres separadas por vírgula, ex.: Instagram: https://instagram.com/x,X: https://x.com/x
SOCIAL_LINKS=

# ===== Publicação =====
# dry_run = renderiza mas não envia. Troque para youtube quando validar a saída.
PUBLISH_MODE=dry_run
YOUTUBE_PRIVACY_STATUS=private
# 22 = Pessoas e blogs, 24 = Entretenimento, 25 = Notícias e política
YOUTUBE_CATEGORY_ID=22
YOUTUBE_CLIENT_SECRETS_FILE=secrets/client_secret.json
YOUTUBE_TOKEN_FILE=secrets/youtube_token.json
# Publicação cruzada além do YouTube: facebook, instagram, threads (separe por vírgula; vazio =
# só YouTube). Só age com PUBLISH_MODE=youtube. Veja docs/publishing.md
CROSSPOST_NETWORKS=
# Redes que falham são reenviadas depois (nunca reenvia ao YouTube)
CROSSPOST_MAX_ATTEMPTS=5
CROSSPOST_RETRY_MINUTES=15
# Facebook (vídeo para longos, Reel para shorts). Token DA PÁGINA, de longa duração
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
# Versão da Graph API (Facebook e Instagram)
FACEBOOK_API_VERSION=v23.0
# Instagram (só Reels dos shorts): ID da conta Business/Creator ligada à Página.
# Vazio no token = usa o token da Página
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
# Threads (post de texto com o link do YouTube). O token expira em 60 dias
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
# Cota padrão da API: 10.000/dia, ~1.600 por upload => ~6 envios/dia, longos e shorts somados.
# Peça aumento de cota ao YouTube se for postar muitos shorts
MAX_PUBLISH_PER_DAY=5

# ===== Fila de postagem =====
# true = o corte sobe assim que fica pronto, mas agendado (o YouTube publica na hora marcada).
# Cada agendamento sobe como privado e vira público no horário; YOUTUBE_PRIVACY_STATUS é ignorado.
PUBLISH_SCHEDULE_ENABLED=false
PUBLISH_TIMEZONE=America/Sao_Paulo
# Horários fixos HH:MM. Vazio = distribui MAX_PUBLISH_PER_DAY horários entre início e fim da janela
PUBLISH_SLOTS=
PUBLISH_WINDOW_START=09:00
PUBLISH_WINDOW_END=22:00
# Antecedência mínima entre o envio e o horário marcado
PUBLISH_MIN_LEAD_MINUTES=30
# Até quantos dias à frente a fila aceita cortes (cheia = espera liberar)
PUBLISH_QUEUE_DAYS=3

# ===== Outros =====
DATA_DIR=data
NOTIFY_WEBHOOK_URL=
LOG_LEVEL=INFO

# ---------- Thumbnails ----------
# Só cortes longos (Shorts não aceitam thumbnail própria).
# none = sem thumbnail (o YouTube escolhe um frame). template = melhor frame do corte (rosto bem
# enquadrado, fundo limpo; detector de rosto do Google/MediaPipe) + texto em template. Sem IA generativa.
THUMBNAIL_PROVIDER=none
THUMBNAIL_SAMPLE_COUNT=24
THUMBNAIL_FACE_MIN_CONFIDENCE=0.6
THUMBNAIL_MAX_ZOOM=1.6
THUMBNAIL_ACCENT_COLOR=#FFD400
# Vazio = Anton (OFL), embutida no pacote
THUMBNAIL_FONT_PATH=
THUMBNAIL_LOGO_PATH=
